# Optional password-reset email. Keep actual credentials outside Git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Loopback PC-only phase. Use owner recovery code without SMTP.
APP_ORIGIN=http://127.0.0.1:4310
PORT=4310
# Phone access through Tailscale: your PC's Tailscale name, e.g. my-pc.tail1234.ts.net
# (scripts/setup-phone.ps1 fills this in for you).
ALLOWED_HOSTS=
# Automatic daily backups go to .data/backups unless you point this somewhere else,
# e.g. a USB drive or a synced folder: D:\loan-backups
LOAN_BACKUP_DIR=
